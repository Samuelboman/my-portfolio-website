<%- include("partials/header") %>

<section id="projects" class="projects-section">
    <h2><%= title %></h2>

    <div class="projects-grid">
        <!-- Project 1: E-commerce Platform -->
        <div class="project-card">
            <div class="project-image">
                <img src="/images/safe-trip app img.jpeg" alt="safet-trip app">
            </div>
            <div class="project-content">
                <h3>Safe-Trip mobile system</h3>
                <p>A full-featured e-commerce application with product listings, shopping cart, checkout, and admin panel.</p>
                    
                <div class="tech-stack">
                    
                    <span class="tech-tag">Node.js</span>
                    <span class="tech-tag">Express</span>
                    <span class="tech-tag">MongoDB</span>
                   
                </div>

                <div class="project-buttons">
                    <a href="https://github.com/Samuelboman/safetrip-backend" class="project-btn github-btn">
                        <i class="fab fa-github"></i> GitHub
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 2: Education Website -->
        <div class="project-card">
            <div class="project-image">
                <img src="/images/timetracking-dashboard img.jpeg" alt="Time-tracking Dashboard">
            </div>
            <div class="project-content">
                <h3>Frontend UI Project</h3>
                <p>Responsive interfaces of a Time tracking dashboard.</p>
                    
                <div class="tech-stack">
                    <span class="tech-tag">React</span>
                    <span class="tech-tag">JavaScript</span>
                    <span class="tech-tag">CSS3</span>
                    <span class="tech-tag">HTML5</span>
                    
                </div>

                <div class="project-buttons">
                    <a href="https://time-tracker-bom.netlify.app/" class="project-btn github-btn">
                        <i class="fab fa-github"></i> GitHub
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 3: Task Management API -->
        <div class="project-card">
            <div class="project-image">
                <img src="https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600&h=400&fit=crop" alt="API Development">
            </div>
            <div class="project-content">
                <h3>Collaborated On An AI Job Recommendation API</h3>
                <p>Backend system built with Node.js, Express, and MySQL.</p>
                    
                <div class="tech-stack">
                    <span class="tech-tag">Node.js</span>
                    <span class="tech-tag">Express</span>
                    <span class="tech-tag">My MySQL</span>
                </div> 

                <div class="project-buttons">
                   
                    <a href="https://github.com/Samuelboman/ai-job-recommendation-system" class="project-btn github-btn">
                        <i class="fab fa-github"></i> GitHub
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 4: Portfolio Website -->
        <div class="project-card">
            <div class="project-image">
                <img src="./images/r.jpg" alt="Portfolio Website">
            </div>
            <div class="project-content">
                <h3>Other projects</h3>
                <p>To see more of my projects pls click on the button below.</p>

                <div class="project-buttons">
                    <a href="https://app.netlify.com/teams/samuelboman/projects" class="project-btn demo-btn">See more</a>
                    <a href="https://github.com/Samuelboman?tab=repositories" class="project-btn github-btn">
                        <i class="fab fa-github"></i> GitHub
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include("partials/footer") %>